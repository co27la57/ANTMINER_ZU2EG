########## 1. monitorcg script (what it does) ##########
#!/bin/sh
#set -x
check_inter="20s"
while true; do
	sleep $check_inter
	#date
	a="$(ps | grep cgminer | grep -v 'grep cgminer')"
	if [ -z "$a" ] ; then
		/etc/init.d/cgminer.sh restart
	fi
done

########## 2. cgminer.sh startup script ##########
#!/bin/sh

PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
DAEMON=/usr/bin/cgminer
NAME=cgminer
DESC="Cgminer daemon"

set -e
#set -x
test -x "$DAEMON" || exit 0


#echo 403 > /sys/class/gpio/export
#echo out > /sys/class/gpio/gpio403/direction
#echo 1 > /sys/class/gpio/gpio403/value
#echo 0 > /sys/class/gpio/gpio403/value
#sleep 1
#echo 1 > /sys/class/gpio/gpio403/value


if [ ! -d /sys/class/gpio/gpio403 ]; then
    echo 403 > /sys/class/gpio/export
    echo out > /sys/class/gpio/gpio403/direction
    echo 1 > /sys/class/gpio/gpio403/value
fi

# Zynq7000 DASH miner
export HAL_CONFIG_PATH=/etc
# RED LED: GPIO411
if [ ! -d /sys/class/gpio/gpio411 ]; then
    echo 411 > /sys/class/gpio/export
    echo out > /sys/class/gpio/gpio411/direction
    echo 1 > /sys/class/gpio/gpio411/value
fi

# GREEN LED: GPIO408
if [ ! -d /sys/class/gpio/gpio408 ]; then
    echo 408 > /sys/class/gpio/export
    echo out > /sys/class/gpio/gpio408/direction
    echo 1 > /sys/class/gpio/gpio408/value
fi

# POWER ASIC: GPIO404
if [ ! -d /sys/class/gpio/gpio404 ]; then
    echo 404 > /sys/class/gpio/export
    echo out > /sys/class/gpio/gpio404/direction
    echo 1 > /sys/class/gpio/gpio404/value
fi

# LCD: D0 : CS
